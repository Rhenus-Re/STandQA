  "groups": [],
  "nodes": [
    { "id": "risk_hint", "lane": "source", "col": 0, "type": "security", "label": "风险线索", "sublabel": "算法 / 状态 / 输出", "tag": "待验证风险", "width": 170 },
    { "id": "boundary_method", "lane": "boundary", "col": 1, "type": "backend", "label": "边界值", "sublabel": "最小 / 临界 / 最大", "tag": "选择方法", "width": 160 },
    { "id": "boundary_condition", "lane": "boundary", "col": 2, "type": "backend", "label": "构造输入条件", "sublabel": "0 bytes · V1/2 · border 0/4", "tag": "边界集合", "width": 190 },
    { "id": "boundary_oracle", "lane": "boundary", "col": 3, "type": "database", "label": "预期断言", "sublabel": "不异常 / 尺寸正确 / 宽度正确", "tag": "可观测结果", "width": 200 },
    { "id": "equivalence_method", "lane": "equivalence", "col": 1, "type": "backend", "label": "等价类", "sublabel": "有效 / 无效 / 后端分类", "tag": "选择方法", "width": 160 },
    { "id": "equivalence_condition", "lane": "equivalence", "col": 2, "type": "backend", "label": "构造输入条件", "sublabel": "BYTE/数字/中文 · PNG/SVG/ASCII", "tag": "等价类集合", "width": 210 },
    { "id": "equivalence_oracle", "lane": "equivalence", "col": 3, "type": "database", "label": "预期断言", "sublabel": "输出格式 / 文件可读 / 分支一致", "tag": "可观测结果", "width": 200 },
