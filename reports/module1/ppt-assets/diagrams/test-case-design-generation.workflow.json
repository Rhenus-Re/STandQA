    { "id": "boundary_path_2", "from": "boundary_condition", "to": "boundary_oracle", "label": "绑定断言", "role": "main", "variant": "default" },
    { "id": "equivalence_path_1", "from": "equivalence_method", "to": "equivalence_condition", "label": "划分集合", "role": "main", "variant": "emphasis" },
    { "id": "equivalence_path_2", "from": "equivalence_condition", "to": "equivalence_oracle", "label": "绑定断言", "role": "main", "variant": "default" },
    { "id": "scenario_path_1", "from": "scenario_method", "to": "scenario_condition", "label": "编排步骤", "role": "main", "variant": "emphasis" },
    { "id": "scenario_path_2", "from": "scenario_condition", "to": "scenario_oracle", "label": "绑定断言", "role": "main", "variant": "default" },
    { "id": "boundary_to_corpus", "from": "boundary_oracle", "to": "case_corpus", "label": "归档用例", "role": "branch", "variant": "dashed" },
    { "id": "equivalence_to_corpus", "from": "equivalence_oracle", "to": "case_corpus", "label": "归档用例", "role": "branch", "variant": "dashed" },
    { "id": "scenario_to_corpus", "from": "scenario_oracle", "to": "case_corpus", "label": "归档用例", "role": "branch", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "用例生成规则",
      "items": [
        "每条用例都包含输入条件、执行路径和预期断言",
        "边界值关注临界行为，等价类关注代表性覆盖",
        "场景法关注跨函数、跨对象和端到端链路"
      ]
    },
    {
      "dot": "orange",
      "title": "高价值组合",
      "items": [
        "Version 1 → Version 2 → 新建 Version 2：缓存与矩阵一致性",
        "border=4 → print_tty()：输出宽度 46 → 58"
      ]
    }
  ]
}
