      "stage": 3,
      "row": 2,
      "width": 164
    },
    {
      "id": "renderOutputs",
      "type": "external",
      "label": "PNG / SVG / ASCII",
      "sublabel": "同一矩阵的三种呈现",
      "tag": "C 域输出",
      "stage": 4,
      "row": 1,
      "width": 164
    }
  ],
  "flows": [
    {
      "id": "input-to-add-data",
      "from": "urlInput",
      "to": "addData",
      "label": "原始 URL 字节",
      "classification": "UTF-8",
      "variant": "emphasis"
    },
    {
      "id": "add-data-to-chunks",
      "from": "addData",
      "to": "dataChunks",
      "label": "待编码数据",
      "classification": "data_list",
      "labelDy": 24
    },
    {
      "id": "chunks-to-fit",
      "from": "dataChunks",
      "to": "bestFit",
      "label": "模式与长度",
      "classification": "needed bits",
      "route": "top-channel"
    },
    {
      "id": "fit-to-codewords",
      "from": "bestFit",
      "to": "codewords",
      "label": "版本 8，M 级纠错",
      "classification": "capacity",
      "labelDy": 24
    },
    {
      "id": "codewords-to-mask",
      "from": "codewords",
      "to": "maskScore",
      "label": "纠错后的码字",
      "classification": "RS output",
      "variant": "emphasis"
    },
    {
      "id": "mask-to-matrix",
      "from": "maskScore",
      "to": "matrix",
      "label": "最低惩罚分掩码",
      "classification": "mask 2",
      "labelDy": 24
    },
    {
      "id": "matrix-to-renderer",
      "from": "matrix",
      "to": "renderOutputs",
      "label": "黑白模块矩阵",
      "classification": "render"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "实际输入与结果",
      "items": [
        "输入为完整 Bilibili URL，共 129 个 UTF-8 字节",
        "自动选择版本 8、M 级纠错与掩码 2",
        "最终矩阵为 49 × 49，含静区输出为 57 × 57"
      ]
    },
    {
      "dot": "emerald",
      "title": "测试对应点",
      "items": [
        "A 域检查编码、容量、RS 纠错与掩码评分",
        "B 域检查版本选择、对象状态和矩阵生成",
        "C 域检查 PNG、SVG 与终端输出是否忠实呈现矩阵"
      ]
    }
  ]
