    { "label": "输出" }
  ],
  "nodes": [
    {
      "id": "urlInput",
      "type": "external",
      "label": "Bilibili URL",
      "sublabel": "129 UTF-8 字节",
      "tag": "输入样例",
      "stage": 0,
      "row": 1
    },
    {
      "id": "addData",
      "type": "backend",
      "label": "QRCode.add_data()",
      "sublabel": "接收字节并清除缓存",
      "tag": "main.py",
      "stage": 1,
      "row": 0
    },
    {
      "id": "dataChunks",
      "type": "backend",
      "label": "optimal_data_chunks()",
      "sublabel": "选择 BYTE 编码块",
      "tag": "util.py",
      "stage": 1,
      "row": 2,
      "width": 156
    },
    {
      "id": "bestFit",
      "type": "backend",
      "label": "best_fit()",
      "sublabel": "选择最小可容纳版本 8",
      "tag": "main.py",
      "stage": 2,
      "row": 0
    },
    {
      "id": "codewords",
      "type": "backend",
      "label": "create_data() / create_bytes()",
      "sublabel": "比特流、填充与 RS 纠错",
